<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="280.0" prefWidth="354.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Pane prefHeight="251.0" prefWidth="314.0">
         <children>
             <Label layoutX="-7.0" layoutY="-3.5" text="Login to existing Account">
                 <font>
                     <Font name="Arial Rounded MT Bold" size="12.0" />
                 </font></Label>
            <TextField fx:id="emailID" layoutX="38.0" layoutY="44.0" prefHeight="25.0" prefWidth="237.0" promptText="Email" />
            <TextField fx:id="passwordID" layoutX="38.0" layoutY="92.0" prefHeight="25.0" prefWidth="237.0" promptText="Password" />
            <Button fx:id="signupbuttonID" layoutX="238.0" layoutY="214.0" mnemonicParsing="false" onAction="#signupClick" prefHeight="25.0" prefWidth="74.0" text="Sign up" />
            <Button fx:id="loginbuttonID" layoutX="38.0" layoutY="153.0" mnemonicParsing="false" onAction="#loginClick" prefHeight="25.0" prefWidth="237.0" text="Login" />
            <ChoiceBox layoutX="222.0" layoutY="-12.0" prefHeight="18.0" prefWidth="106.0" />
         </children>
      </Pane>
   </children>
</VBox>
